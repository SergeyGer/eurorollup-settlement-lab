{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@eurorollup/dealing": [
        "../../packages/dealing/src/index.ts"
      ],
      "@eurorollup/policy-lab": [
        "../../packages/policy-lab/src/index.ts"
      ],
