{
  "name": "eurorollup-settlement-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source euro settlement sandbox for crypto trades, tokenized fund orders and AI policy simulation.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "a05:verify": "tsx scripts/verify-a05-evidence.ts",
    "a07:batch-drill": "tsx scripts/a07-batch-drill.ts",
    "a07:economics": "tsx scripts/a07-bundle.ts",
    "a07:operations": "tsx scripts/a07-operations.ts",
    "a07:verify": "tsx scripts/verify-a07-economics.ts",
    "a08:public-check": "tsx scripts/a08-public-check.ts",
    "a08:verify": "tsx scripts/verify-a08-evidence.ts",
    "aa:scenario": "tsx scripts/aa-scenario.ts",
    "aa:verify": "tsx scripts/verify-aa-evidence.ts",
    "api": "pnpm --filter @eurorollup/api dev",
    "api:openapi": "tsx apps/api/scripts/dump-openapi.ts",
    "build": "pnpm --filter @eurorollup/web build",
    "check:line-endings": "tsx scripts/check-line-endings.ts",
    "check:links": "tsx scripts/check-public-links.ts",
    "check:sessions": "tsx scripts/check-publication-sessions.ts",
    "demo": "tsx apps/api/scripts/quickstart.ts",
    "demo:partner": "tsx apps/api/scripts/quickstart.ts",
    "dev": "pnpm --filter @eurorollup/web dev",
    "dev:api": "pnpm --filter @eurorollup/api dev",
    "devnet:down": "bash devnet/local/down.sh",
    "devnet:local:down": "bash devnet/local/down.sh",
    "devnet:local:up": "bash devnet/local/up.sh",
    "devnet:up": "bash devnet/local/up.sh",
    "eligibility:all": "pnpm eligibility:fixtures && pnpm eligibility:artifacts && pnpm eligibility:evidence && pnpm eligibility:verify",
    "eligibility:artifacts": "tsx scripts/build-eligibility-artifacts.ts",
    "eligibility:evidence": "tsx packages/eligibility/src/cli.ts evidence",
    "eligibility:fixtures": "tsx scripts/build-eligibility-fixtures.ts",
    "eligibility:matrix": "tsx packages/eligibility/src/cli.ts matrix",
    "eligibility:proofs": "tsx packages/eligibility/src/cli.ts proofs",
    "eligibility:verify": "tsx packages/eligibility/src/cli.ts verify",
    "film:build": "tsx scripts/build-release-film.ts",
    "local:evidence": "tsx scripts/local-evidence.ts",
    "policy:eval": "tsx packages/policy-lab/src/cli.ts eval",
    "policy:eval:mock": "tsx packages/policy-lab/src/cli.ts eval --adapter mock",
    "policy:model:status": "tsx packages/policy-lab/src/cli.ts model-status",
    "policy:record": "tsx packages/policy-lab/src/cli.ts record",
    "policy:replay": "tsx packages/policy-lab/src/cli.ts replay",
    "policy:verify": "tsx packages/policy-lab/src/cli.ts verify",
    "preview": "pnpm --filter @eurorollup/web preview",
    "release:attest": "tsx scripts/build-release-attestation.ts",
    "release:attest:verify": "tsx scripts/verify-release-attestation.ts",
    "release:checks": "tsx scripts/build-release-checks.ts",
    "release:package": "tsx scripts/build-release-package.ts",
    "release:verify": "tsx scripts/verify-release-checks.ts",
    "scenario:api": "tsx apps/api/scripts/run-evidence.ts",
    "scenario:boundary": "tsx packages/dealing/src/cli.ts boundary",
    "scenario:golden": "tsx packages/dealing/src/cli.ts golden",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/dealing/tsconfig.json --noEmit && tsc -p packages/policy-lab/tsconfig.json --noEmit && tsc -p packages/economics/tsconfig.json --noEmit && tsc -p packages/eligibility/tsconfig.json --noEmit && tsc -p packages/sdk/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "ui:checks": "tsx scripts/ui-checks.ts",
    "verify": "tsx packages/dealing/src/cli.ts verify"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@types/node": "^22.10.5",
    "ajv": "^8.17.1",
    "ethers": "6.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.2",
    "playwright": "1.55.1"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "@openzeppelin/contracts@3.4.2-solc-0.7": "4.9.6",
      "@openzeppelin/contracts@>=3.3.0 <3.4.2": "4.9.6"
    }
  }
}
