# Local credentials — never commit. The GitHub token is provided locally by the maintainer.
.git-token
.env
.env.*
!.env.example

# Maintainer scratch space used by local automation
.dsh-tmp/

# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Build output
dist/
build/
out/
coverage/
*.tsbuildinfo
.vite/

# Generated evidence runs (committed release packs live in evidence/)
evidence/tmp/
tmp/
*.log

# Local databases and snapshots
*.sqlite
*.sqlite-journal
.data/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Local model adapter caches (the model itself is never committed)
.models/
eval-tmp/
# Local model evaluation output
.ollama-models/

# Noir build output and generated witnesses
circuits/target/
circuits/**/Prover.toml

# controlled local devnet runtime state
.devnet-local/

# release packaging output (top-level only; docs/release is tracked)
/release/

# local film production workspace
/tmp-film/

# the release film is attached to the GitHub Release, not committed
media/film/*.mp4

# local-only film for player testing (the release MP4 is a GitHub Release asset)
apps/web/public/*.mp4

# local-only player test transcode (the published film is the release MP4)
apps/web/public/*.webm

# S18 local acceptance working directory
tmp-s18/

# NET-01 local capture working directory
tmp-s19/
