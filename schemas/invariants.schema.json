{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyGer/eurorollup-settlement-lab/schemas/invariants.schema.json",
  "title": "A06 invariant evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "fixtureVersion",
    "engineVersion",
    "serviceVersion",
    "generatedBy",
    "cases",
    "summary",
    "businessDigest"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "fixtureId": { "type": "string", "const": "A06-invariants" },
    "fixtureVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "serviceVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedBy": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "title", "steps", "checks", "pass"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "items": { "type": "object" } },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "object" } },
          "pass": { "type": "boolean" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "businessDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
