{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyGer/eurorollup-settlement-lab/schemas/redemption-receipt.schema.json",
  "title": "Redemption receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "orderId",
    "businessState",
    "assetId",
    "unitsBase",
    "assetDecimals",
    "cashAssetId",
    "cashPaidBase",
    "cashDecimals",
    "navEurPerUnit",
    "investorChargeBase"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "orderId": { "type": "string", "minLength": 1 },
    "businessState": { "type": "string", "enum": ["REDEEMED"] },
    "assetId": { "type": "string", "const": "eFUND" },
    "unitsBase": { "type": "string", "pattern": "^[0-9]+$" },
    "assetDecimals": { "type": "integer", "const": 6 },
    "cashAssetId": { "type": "string", "const": "dEUR" },
    "cashPaidBase": { "type": "string", "pattern": "^[0-9]+$" },
    "cashDecimals": { "type": "integer", "const": 6 },
    "navEurPerUnit": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "investorChargeBase": { "type": "string", "const": "0" }
  }
}
