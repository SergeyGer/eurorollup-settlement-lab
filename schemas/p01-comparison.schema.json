{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyGer/eurorollup-settlement-lab/schemas/p01-comparison.schema.json",
  "title": "P01 Friday cutoff comparison pack",
  "description": "Versioned evidence pack for the P01 deterministic two-branch comparison. A fixed confirmed patch reproduces the same bytes, comparison digest and pack digest in the browser, the service and the CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "fixtureId",
    "fixtureVersion",
    "engineVersion",
    "policyLabVersion",
    "generatedBy",
    "fixtureHash",
    "calendarHash",
    "baselinePolicy",
    "candidatePolicy",
    "baselinePolicyHash",
    "candidatePolicyHash",
    "branches",
    "orderChanges",
    "affectedOrders",
    "totalOrders",
    "extraReservedAtFridayCloseBase",
    "deltas",
    "boundaryCases",
    "boundarySummary",
    "checks",
    "comparisonDigest",
    "packDigest"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "packId": { "type": "string", "const": "policy-lab-p01" },
    "fixtureId": { "type": "string", "const": "P01" },
    "fixtureVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policyLabVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedBy": { "type": "string", "minLength": 1 },
    "fixtureHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "calendarHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baselinePolicy": { "type": "object" },
    "candidatePolicy": { "type": "object" },
    "baselinePolicyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidatePolicyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "branches": { "type": "object" },
    "orderChanges": { "type": "array", "minItems": 1 },
    "affectedOrders": { "type": "integer", "minimum": 0 },
    "totalOrders": { "type": "integer", "minimum": 1 },
    "extraReservedAtFridayCloseBase": { "type": "string", "pattern": "^-?[0-9]+$" },
    "deltas": { "type": "object" },
    "boundaryCases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "description", "requestedAt", "calendarId", "baseline", "candidate", "expected", "pass"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "requestedAt": { "type": "string", "minLength": 1 },
          "calendarId": { "type": "string", "minLength": 1 },
          "baseline": { "type": "object" },
          "candidate": { "type": "object" },
          "expected": { "type": "object" },
          "pass": { "type": "boolean", "const": true }
        }
      }
    },
    "boundarySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": { "type": "array", "items": { "type": "string" } },
    "comparisonDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
