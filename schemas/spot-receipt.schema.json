{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyGer/eurorollup-settlement-lab/schemas/spot-receipt.schema.json",
  "title": "Spot fill receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "orderId",
    "businessState",
    "assetId",
    "unitsBase",
    "assetDecimals",
    "cashAssetId",
    "cashDeployedBase",
    "cashDecimals",
    "priceEurPerUnit",
    "investorChargeBase"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "orderId": { "type": "string", "minLength": 1 },
    "businessState": { "type": "string", "enum": ["FILLED"] },
    "assetId": { "type": "string", "const": "tWETH" },
    "unitsBase": { "type": "string", "pattern": "^[0-9]+$" },
    "assetDecimals": { "type": "integer", "const": 18 },
    "cashAssetId": { "type": "string", "const": "dEUR" },
    "cashDeployedBase": { "type": "string", "pattern": "^[0-9]+$" },
    "cashDecimals": { "type": "integer", "const": 6 },
    "priceEurPerUnit": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "investorChargeBase": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
