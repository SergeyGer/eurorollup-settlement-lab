{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyGer/eurorollup-settlement-lab/schemas/golden-run.schema.json",
  "title": "G01 golden run evidence",
  "description": "Deterministic evidence pack for the G01 portfolio fixture and its separate redemption case. A fixed input set reproduces the same bytes and the same business digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "fixtureVersion",
    "engineVersion",
    "calendar",
    "cases",
    "businessDigest",
    "checksums"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "fixtureId": {
      "type": "string",
      "const": "G01"
    },
    "fixtureVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendarId",
        "version"
      ],
      "properties": {
        "calendarId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/goldenCase"
      }
    },
    "businessDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "steps",
        "journal",
        "receipts",
        "checkpoints"
      ],
      "properties": {
        "inputs": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "steps": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "journal": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoints": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "accountId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "investor",
            "dealer",
            "fundEscrow",
            "issuerTreasury",
            "feeRecipient",
            "issuanceControl"
          ]
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "posting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "assetId",
        "amountBase"
      ],
      "properties": {
        "account": {
          "$ref": "#/$defs/account"
        },
        "assetId": {
          "type": "string",
          "enum": [
            "dEUR",
            "tWETH",
            "eFUND"
          ]
        },
        "amountBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      }
    },
    "journalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "stepId",
        "occurredAt",
        "eventType",
        "description",
        "postings"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1
        },
        "stepId": {
          "type": "string",
          "minLength": 1
        },
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "postings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/posting"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "eventType",
        "title",
        "description",
        "occurredAt",
        "businessEffects",
        "journal"
      ],
      "properties": {
        "stepId": {
          "type": "string",
          "minLength": 1
        },
        "eventType": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "minLength": 1
        },
        "businessEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journalEntry"
          }
        }
      }
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "balanceBase",
        "reservedBase",
        "markPriceBase",
        "markedValueBase",
        "displayDecimals"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "enum": [
            "dEUR",
            "tWETH",
            "eFUND"
          ]
        },
        "balanceBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "reservedBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "markPriceBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "markedValueBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "displayDecimals": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "portfolioSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "investorId",
        "at",
        "spendableCashBase",
        "reservedCashBase",
        "holdings",
        "totalMarkedValueBase",
        "pendingOrders"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "investorId": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "spendableCashBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "reservedCashBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "holdings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holding"
          }
        },
        "totalMarkedValueBase": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "pendingOrders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orderId",
              "kind",
              "status"
            ],
            "properties": {
              "orderId": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "spot",
                  "fund-subscription",
                  "fund-redemption"
                ]
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "dealingDate": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "reservedCashBase": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              },
              "reservedUnitsBase": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        }
      }
    },
    "goldenCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "title",
        "inputs",
        "inputsHash",
        "steps",
        "receipts",
        "checkpoints",
        "finalPortfolio",
        "businessDigest"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object"
        },
        "inputsHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/portfolioSnapshot"
          }
        },
        "finalPortfolio": {
          "$ref": "#/$defs/portfolioSnapshot"
        },
        "businessDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
