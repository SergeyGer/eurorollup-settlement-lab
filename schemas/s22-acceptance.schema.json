{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eurorollup.test/schemas/s22-acceptance.schema.json",
  "title": "S22 independent acceptance record",
  "type": "object",
  "required": ["schemaVersion", "reportId", "packId", "generatedBy", "generatedAt", "commit", "tree", "environment", "attribution", "evidenceDigests", "requirements", "gatesSummary", "walkthrough", "passed", "limitations", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportId": { "const": "S22-independent-acceptance" },
    "packId": { "const": "S22" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": { "type": "object", "required": ["node", "pnpm", "platform", "acceptedWorktreeClean", "independentClone"] },
    "attribution": { "type": "object", "required": ["executedInCleanClone", "executedInAcceptedWorktree", "verifiedFromEvidence", "note"] },
    "evidenceDigests": { "type": "object", "minProperties": 10 },
    "requirements": {
      "type": "array", "minItems": 19,
      "items": {
        "type": "object",
        "required": ["id", "title", "mode", "sourceCommit", "command", "environment", "expected", "observed", "evidenceLink", "disposition", "incompleteReason"],
        "properties": {
          "id": { "type": "string", "pattern": "^S22-AC-[0-9]{2}$" },
          "mode": { "enum": ["deterministic", "policy-boundary", "negative-path", "live-lane", "package", "public-walkthrough"] },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "disposition": { "enum": ["qualified", "incomplete", "failed"] }
        }
      }
    },
    "gatesSummary": { "type": "object", "required": ["total", "qualified", "incomplete", "failed"] },
    "walkthrough": { "type": "object", "required": ["landingPage", "filmAsset", "captions", "releases", "f1530", "liveInvestment"] },
    "passed": { "const": true },
    "limitations": { "type": "array", "minItems": 2 },
    "notes": { "type": "array", "minItems": 2 }
  }
}
