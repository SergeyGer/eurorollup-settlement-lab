{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eurorollup.test/schemas/a08-public-release.schema.json",
  "title": "A08 public release verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "packId", "generatedBy", "generatedAt", "commit", "version", "publicReplay", "quickstart", "publicLinks", "releasePackage", "film", "publicPartsPassed", "passed", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportId": { "const": "A08-public-release" },
    "packId": { "const": "A08-release" },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publicReplay": {
      "type": "object",
      "required": ["url", "authentication", "httpStatus", "contentChecks", "cleanBrowser"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "authentication": { "const": "none" },
        "httpStatus": { "const": 200 },
        "contentType": { "type": "string" },
        "contentChecks": {
          "type": "object",
          "required": ["hasTitle", "hasAppMount"],
          "properties": { "hasTitle": { "const": true }, "hasAppMount": { "const": true } }
        },
        "cleanBrowser": {
          "type": "object",
          "required": ["engine", "version", "viewport", "title", "pageErrors", "consoleErrors", "views", "screenshots"],
          "properties": {
            "engine": { "type": "string" },
            "version": { "type": "string" },
            "viewport": { "type": "string" },
            "title": { "type": "string" },
            "pageErrors": { "type": "array", "items": { "type": "string" } },
            "consoleErrors": { "type": "array", "items": { "type": "string" } },
            "views": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "object",
                "required": ["button", "marker", "rendered"],
                "properties": { "button": { "type": "string" }, "marker": { "type": "string" }, "rendered": { "const": true } }
              }
            },
            "screenshots": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "sha256"],
                "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
              }
            }
          }
        }
      }
    },
    "quickstart": { "type": "object" },
    "publicLinks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["url", "statusCode", "authentication"],
        "properties": {
          "url": { "type": "string" },
          "statusCode": { "type": "integer" },
          "authentication": { "const": "none" }
        }
      }
    },
    "releasePackage": {
      "type": "object",
      "required": ["fileName", "sha256", "bytes", "downloadMode", "verified"],
      "properties": {
        "fileName": { "type": "string" },
        "downloadMode": { "enum": ["local-build", "public-release-asset"] },
        "downloadUrl": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "manifestDigest": { "type": "string" },
        "manifestFileCount": { "type": "integer", "minimum": 1 },
        "verified": {
          "type": "object",
          "required": ["downloaded", "extracted", "manifestMatches"],
          "properties": {
            "downloaded": { "const": true },
            "extracted": { "const": true },
            "manifestMatches": { "const": true },
            "mismatchedFiles": { "type": "array" },
            "missingFiles": { "type": "array" },
            "extraFiles": { "type": "array" }
          }
        }
      }
    },
    "film": {
      "type": "object",
      "required": ["status", "requiredBy"],
      "properties": {
        "status": { "type": "string" },
        "requiredBy": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "publicPartsPassed": { "type": "boolean" },
    "passed": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
