{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyGer/eurorollup-settlement-lab/schemas/evidence-manifest.schema.json",
  "title": "Evidence pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "engineVersion",
    "fixtureId",
    "fixtureVersion",
    "businessDigest",
    "checklist",
    "inputs",
    "files"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "packId": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "fixtureVersion": { "type": "string", "minLength": 1 },
    "businessDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checklist": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileRef" } }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
