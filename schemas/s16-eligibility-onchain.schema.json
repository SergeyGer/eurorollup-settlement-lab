{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eurorollup.test/schemas/s16-eligibility-onchain.schema.json",
  "title": "S16 onchain eligibility enforcement evidence",
  "type": "object",
  "required": ["schemaVersion", "reportId", "packId", "generatedBy", "generatedAt", "commit", "chains", "accounts", "circuit", "verifier", "fixtures", "proofs", "deployments", "abis", "transactions", "failedTransactions", "failures", "stages", "staleRequest", "approvals", "policy", "canonicalBlock", "balancesAtCanonicalBlock", "passed", "limitations", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportId": { "const": "S16-eligibility-onchain" },
    "packId": { "const": "S16" },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "chains": {
      "type": "object",
      "required": ["l1ChainId", "l2ChainId"],
      "properties": { "l1ChainId": { "const": 11155111 }, "l2ChainId": { "const": 16584 } }
    },
    "accounts": { "type": "object", "required": ["investor", "dealer", "issuerTreasury", "feeRecipient", "issuer", "stranger"] },
    "circuit": {
      "type": "object",
      "required": ["circuitId", "circuitSha256", "evmVkHash", "publicInputCount", "proofSystem"],
      "properties": {
        "circuitSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evmVkHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "publicInputCount": { "const": 7 },
        "proofSystem": { "const": "ultra_honk_evm" }
      }
    },
    "verifier": {
      "type": "object",
      "required": ["deployment", "onchainVerified", "tamperedAccepted"],
      "properties": {
        "deployment": { "type": "object", "required": ["address", "codeHash"] },
        "onchainVerified": { "const": true },
        "tamperedAccepted": { "const": false }
      }
    },
    "fixtures": { "type": "object", "required": ["path", "sha256", "epoch1Root", "epoch2Root", "chainId"] },
    "proofs": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["label", "holder", "gate", "epoch", "root", "proofSha256", "publicInputs", "localVerified"],
        "properties": {
          "proofSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "publicInputs": { "type": "array", "minItems": 7, "maxItems": 7 },
          "localVerified": { "const": true },
          "gate": { "enum": ["FUND_SUBSCRIPTION", "FUND_REDEMPTION", "SHARE_TRANSFER", "SPOT_ROUTER"] },
          "epoch": { "type": "integer", "enum": [1, 2] }
        }
      }
    },
    "deployments": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["name", "address", "txHash", "blockNumber", "codeHash", "abiSha256"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "txHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "codeHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "abiSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "abis": { "type": "array", "minItems": 6 },
    "transactions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["stage", "label", "txHash", "blockNumber", "gasUsed", "status"],
        "properties": { "status": { "const": 1 } }
      }
    },
    "failedTransactions": { "type": "object", "required": ["txHash", "blockNumber", "status"], "properties": { "status": { "const": 0 } } },
    "failures": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["label", "expectedRevert", "passed"],
        "properties": { "label": { "type": "string" }, "passed": { "const": true } }
      }
    },
    "stages": { "type": "array", "minItems": 7, "items": { "type": "object", "required": ["stage", "passed", "expected", "observed"] } },
    "staleRequest": {
      "type": "object",
      "required": ["orderId", "approvedPolicyVersion", "currentPolicyVersion", "stateAfterFailure"],
      "properties": {
        "approvedPolicyVersion": { "const": 1 },
        "currentPolicyVersion": { "const": 2 },
        "stateAfterFailure": {
          "type": "object",
          "required": ["failedTx", "escrowReserved", "escrowCash", "investorFund", "fundTotalSupply"],
          "properties": {
            "failedTx": { "properties": { "status": { "const": 0 } } },
            "escrowReserved": { "const": "300000000" },
            "escrowCash": { "const": "300000000" },
            "investorFund": { "const": "50000" },
            "fundTotalSupply": { "const": "50000" }
          }
        }
      }
    },
    "approvals": { "type": "object", "required": ["afterEpoch1", "afterRotation", "final"] },
    "policy": { "type": "object", "required": ["root", "epoch", "policyVersion"], "properties": { "epoch": { "const": 2 }, "policyVersion": { "const": 2 } } },
    "canonicalBlock": { "type": "object", "required": ["number", "hash"] },
    "balancesAtCanonicalBlock": { "type": "object" },
    "passed": { "const": true },
    "limitations": { "type": "array", "minItems": 3 },
    "notes": { "type": "array", "minItems": 2 }
  }
}
