{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eurorollup.test/schemas/release-attestation.schema.json",
  "title": "REL-01 release attestation",
  "type": "object",
  "required": ["schemaVersion", "reportId", "generatedBy", "generatedAt", "tag", "tagCommit", "builtFromCommit", "tagRelationship", "artifacts", "source", "checks", "passed"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportId": { "const": "REL-01-release-attestation" },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tag": { "type": "string" },
    "tagCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "builtFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tagRelationship": {
      "type": "object",
      "required": ["kind", "diffFiles", "note"],
      "properties": {
        "kind": { "const": "evidence-and-metadata-only" },
        "diffFiles": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["status", "path"] } },
        "note": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["package", "film", "captions", "transcript"],
      "properties": {
        "package": { "type": "object", "required": ["fileName", "sha256", "bytes", "builtFromCommit", "url", "exactTaggedTree"] },
        "film": { "type": "object", "required": ["fileName", "sha256", "bytes", "builtFromCommit", "url"] },
        "captions": { "type": "object", "required": ["fileName", "sha256", "url"] },
        "transcript": { "type": "object", "required": ["fileName", "sha256", "url"] }
      }
    },
    "source": { "type": "object" },
    "checks": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["id", "passed"] } },
    "passed": { "type": "boolean" }
  }
}
